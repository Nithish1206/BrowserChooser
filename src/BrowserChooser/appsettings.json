{
  // Settings shipped with the app. To change them without editing this file (which is replaced on upgrade),
  // put the same keys in %LOCALAPPDATA%\BrowserChooser\appsettings.json; that file wins.

  "Logging": {
    // Verbose, Debug, Information, Warning, Error or Fatal.
    "MinimumLevel": "Information",
    // One log file per day in %LOCALAPPDATA%\BrowserChooser\Logs; older files are deleted.
    "RetainedFileCountLimit": 14
  },

  "Appearance": {
    // Picker colours: "System" follows the Windows app mode (Settings > Personalization > Colours),
    // or force "Light" or "Dark".
    "Theme": "System"
  },

  "BrowserChooser": {
    // Hide browsers by display name, executable file name or registry key name.
    // Internet Explorer is still registered on Windows 11 but only redirects to Edge.
    "ExcludedBrowsers": [ "iexplore.exe" ],

    // Browsers Windows doesn't know about, such as portable installs. Example:
    // {
    //   "Name": "Chromium (portable)",
    //   "ExecutablePath": "D:\\Tools\\Chromium\\chrome.exe",
    //   "Family": "Chromium",                              // Chromium, Firefox or Other; omit to detect
    //   "UserDataPath": "D:\\Tools\\Chromium\\User Data"   // Chromium only; omit to detect
    // }
    "CustomBrowsers": []
  }
}
